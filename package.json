{
  "name": "openlfcp-obsidian",
  "version": "0.3.3",
  "private": true,
  "description": "OpenLFCP Obsidian adapter and product UI.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check . && node scripts/check-boundaries.mjs && node scripts/check-boundaries.mjs --self-test",
    "test": "vitest run",
    "test:security": "vitest run test/e2e/security-vertical-slice.test.ts",
    "native": "pnpm run build && pnpm --dir test/native install --frozen-lockfile && pnpm --dir test/native test",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@openlfcp/client": "0.1.5",
    "@openlfcp/core": "0.1.5",
    "@openlfcp/crypto": "0.1.5",
    "@openlfcp/shared-objects": "0.1.5",
    "@openlfcp/storage": "0.1.5",
    "@openlfcp/storage-idb": "0.1.5",
    "@openlfcp/wire": "0.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "6.2.5",
    "obsidian": "1.13.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
